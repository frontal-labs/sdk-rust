{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust: Format check",
      "type": "process",
      "command": "cargo",
      "args": [
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Rust: Build workspace",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--workspace"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Rust: Clippy",
      "type": "process",
      "command": "cargo",
      "args": [
        "clippy",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Rust: Tests (nextest)",
      "type": "process",
      "command": "cargo",
      "args": [
        "nextest",
        "run"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Rust: Documentation tests",
      "type": "process",
      "command": "cargo",
      "args": [
        "test",
        "--doc"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Rust: Check endpoint contracts",
      "type": "process",
      "command": "cargo",
      "args": [
        "xtask",
        "contract"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    }
  ]
}
